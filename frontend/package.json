{
  "name": "pis-next-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test:unit": "vitest",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "openseadragon": "^5.0.1",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/openseadragon": "^5.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.1.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
