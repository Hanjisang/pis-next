# Template only. Copy to an ignored local environment file and inject secrets externally.
PIS_DB_NAME=pis
PIS_DB_USER=pis
PIS_DB_PASSWORD=
PIS_POSTGRES_IMAGE=postgres:18.4-alpine

# Local development and test authentication. Keep blank outside synthetic environments.
PIS_AUTH_TEST_PASSWORD=
PIS_REQUIRE_AUTH=true
PIS_RUNTIME_ENV=production
PIS_TRUSTED_RUNTIME_ENVIRONMENTS=production
PIS_AUTH_COOKIE_SECURE=true

# Production Compose expects immutable, site-approved image references.
PIS_BACKEND_IMAGE=
PIS_FRONTEND_IMAGE=
PIS_HTTP_BIND_ADDRESS=127.0.0.1
PIS_HTTP_PORT=8088

# Backup/restore command defaults. Password remains PIS_DB_PASSWORD and is never written here.
PIS_DB_HOST=127.0.0.1
PIS_DB_PORT=5432
PIS_BACKUP_DIRECTORY=
PIS_BACKUP_RETENTION_DAYS=30
